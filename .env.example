# Configuration reference for local development. Copy values into your shell or a local, untracked
# file. Never commit real credentials. Values prefixed "ati-dev-" are development placeholders,
# and production mode refuses them (ADR-020).

# --- control plane (services/control-plane) ---
APP_ENV=dev
# Listeners default to loopback in dev and test; staging and production must set them explicitly.
ATI_PUBLIC_ADDR=127.0.0.1:8080
ATI_INTERNAL_ADDR=127.0.0.1:8081
ATI_PUBLIC_ORIGIN=http://localhost:3000
ATI_DATABASE_URL=postgres://ati_control_plane@127.0.0.1:55432/ati?sslmode=disable
ATI_TIER1_CTX_DATABASE_URL=postgres://ati_tier1_ctx@127.0.0.1:55432/ati?sslmode=disable
ATI_LIVEKIT_URL=ws://localhost:7880
ATI_LIVEKIT_API_KEY=devapikey
ATI_LIVEKIT_API_SECRET=ati-dev-livekit-api-secret-change-me-0000000
ATI_LIVEKIT_WEBHOOK_API_KEY=devwebhookkey
ATI_LIVEKIT_WEBHOOK_API_SECRET=ati-dev-livekit-webhook-secret-change-me-00
# sha256 (hex) of the agent service token below
ATI_AGENT_SERVICE_TOKEN_SHA256=
# Retention has no defaults: interviews are refused until all three are set (ADR-020).
ATI_RETENTION_TRANSCRIPT_DAYS=
ATI_RETENTION_SESSION_EVENTS_DAYS=
ATI_RETENTION_ASSESSMENT_OUTPUT_DAYS=
# Timing (uncalibrated placeholders): a live session without an interviewer is paused after this.
ATI_AGENT_DISPATCH_TIMEOUT=30s
# Review console sessions (ADR-023): lifetime (15m to 24h, never longer than the staff token) and sign-ins per
# minute per client. Behind a reverse proxy, list it in ATI_TRUSTED_PROXY_CIDRS or every client shares one budget.
ATI_STAFF_SESSION_TTL=8h
ATI_STAFF_SIGNINS_PER_MINUTE=10
# Tier-2 handoff (ADR-022): the outbox relay runs only when ATI_REDIS_URL is set (rediss:// in production).
ATI_REDIS_URL=redis://127.0.0.1:6379/0
# sha256 (hex) of the Tier-2 service token below; must differ from the agent token's
ATI_TIER2_SERVICE_TOKEN_SHA256=
# Recording is off by default and fail-closed (ADR-017). Each tenant must also opt in
# (ati-admin tenant-recording) and each candidate must consent. The egress service holds its own
# storage credentials; the S3 values below are used only by `ati-admin recordings purge-expired`.
ATI_RECORDING_ENABLED=false
ATI_RETENTION_AUDIO_RECORDING_DAYS=
ATI_RECORDING_STORAGE_ENCRYPTION_ATTESTED=false
ATI_RECORDING_S3_ENDPOINT=
ATI_RECORDING_S3_BUCKET=
ATI_RECORDING_S3_ACCESS_KEY=
ATI_RECORDING_S3_SECRET_KEY=

# --- Tier-1 voice agent (services/tier1-voice-agent) ---
ATI_AGENT_SERVICE_TOKEN=ati-dev-agent-service-token-change-me-0000
ATI_CONTROL_PLANE_INTERNAL_URL=http://127.0.0.1:8081
ATI_VOICE_ENGINE=scripted
# Only the agent ever holds provider credentials, never the browser or the control plane.
OPENAI_API_KEY=
# Required with ATI_VOICE_ENGINE=openai; must be registered in contracts/models/model-registry.v1.json (ADR-021).
ATI_OPENAI_REALTIME_MODEL=gpt-realtime-2.1
ATI_OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
ATI_OPENAI_BASE_URL=https://api.openai.com/v1

# --- Tier-2 evaluator (services/tier2-evaluator) ---
# reference: deterministic, synthetic rubrics only, refused in production. openai | anthropic: model evaluators
# (not verified against the live providers; production needs a model marked verified in the registry).
ATI_TIER2_EVALUATOR=reference
ATI_TIER2_DATABASE_URL=postgres://ati_tier2_evaluator@127.0.0.1:55432/ati?sslmode=disable
ATI_TIER2_SERVICE_TOKEN=ati-dev-tier2-service-token-change-me-0000
# With a model evaluator: a model ID registered under tier2_evaluator, and the provider key. The endpoint
# defaults to the provider's API; a different OPENAI_BASE_URL / ANTHROPIC_BASE_URL is refused.
ATI_TIER2_MODEL=
ANTHROPIC_API_KEY=
ATI_TIER2_MAX_DELIVERIES=5
ATI_TIER2_VISIBILITY_TIMEOUT_MS=120000

# --- web (apps/web) ---
ATI_CONTROL_PLANE_URL=http://127.0.0.1:8080
ATI_LIVEKIT_PUBLIC_URL=ws://localhost:7880
