{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/interview-plan-v1.schema.json",
  "title": "Interview plan v1",
  "description": "Versioned, immutable-once-published interview plan pinned to a session at creation (PROMPT_AND_EVALUATION section 5: evaluate against the level and rubric declared before the interview). Follow-ups are unconditional in v1: selecting follow-ups from answer content would require either Tier-1 judgement or Tier-2 steering (conflict C5). rubric_ref is never sent to Tier-1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan_id", "version", "status", "title", "language", "seniority_band", "role_family", "synthetic", "items"],
  "properties": {
    "plan_id": {"type": "string", "pattern": "^plan_[a-z0-9_]{3,60}$"},
    "version": {"type": "integer", "minimum": 1},
    "status": {"enum": ["draft", "published"]},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "language": {"enum": ["en", "tr"]},
    "seniority_band": {"enum": ["junior", "mid", "senior", "staff"]},
    "role_family": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,40}$"},
    "synthetic": {"type": "boolean", "description": "true for demo or test content that is not a validated assessment."},
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "text", "modality", "turn_profile", "rubric_ref", "follow_ups"],
        "properties": {
          "item_id": {"type": "string", "pattern": "^[a-z0-9_]{1,32}$"},
          "text": {"type": "string", "minLength": 1, "maxLength": 4000},
          "modality": {"enum": ["voice_qa"]},
          "turn_profile": {"enum": ["standard", "extended_pause"]},
          "rubric_ref": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["rubric_id", "version"],
                "properties": {
                  "rubric_id": {"type": "string", "pattern": "^rub_[a-z0-9_]{3,60}$"},
                  "version": {"type": "integer", "minimum": 1}
                }
              }
            ]
          },
          "follow_ups": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["item_id", "text", "policy"],
              "properties": {
                "item_id": {"type": "string", "pattern": "^[a-z0-9_]{1,32}$"},
                "text": {"type": "string", "minLength": 1, "maxLength": 4000},
                "policy": {"const": "always"}
              }
            }
          }
        }
      }
    }
  }
}
