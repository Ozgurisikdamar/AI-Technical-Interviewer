# Candidate web UI configuration. Every value is read on the server only;
# none of them is ever sent to the browser bundle (never use a NEXT_PUBLIC_ prefix).

# Environment marker (ADR-020). Anything other than "production" shows the
# persistent pre-production banner. The API's own environment also shows it.
APP_ENV=dev

# Control plane public listener. /api/:path* is rewritten here (same-origin for the browser).
# Captured at `next build` time for `next start` (Next.js serves rewrites from the build manifest).
ATI_CONTROL_PLANE_URL=http://127.0.0.1:8080

# LiveKit signaling URL handed to clients; added to the CSP connect-src (ws/wss and http/https origin).
# Read per request by src/proxy.ts.
ATI_LIVEKIT_PUBLIC_URL=ws://localhost:7880
