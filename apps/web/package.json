{
  "name": "@ati/web",
  "version": "0.1.0",
  "private": true,
  "description": "Candidate-facing web UI for the AI technical interviewer (pre-production).",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "NEXT_TELEMETRY_DISABLED=1 next typegen && tsc --noEmit",
    "test": "vitest run",
    "scan-bundle": "node scripts/scan-bundle.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm scan-bundle"
  },
  "dependencies": {
    "livekit-client": "2.23.0",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/dom-mediacapture-record": "1.0.22",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.4",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
